          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>ATENDENDO SUA SOLICITAÇÃO, ESTAMOS ENCAMINHANDO ORÇAMENTO PARA CONSERTO DO EQUIPAMENTO ABAIXO DESCRIMINADO COM VALIDADE DESTA PROPOSTA PELO </Value>
